# ============================================
# CrackDetect .gitignore
# ============================================

# Virtual environments
venv/
Train/venv_train/

# Training (complete folder - data, models, scripts, venv)
Train/

# Model checkpoints (too large for Git)
checkpoints/
*.pth

# Trained model folder (keep folder structure, ignore model files)
model/*
!model/.gitkeep

# Output files
output/

# Test data
test/
beispiel/
Own_data/

# Setup marker
.setup_complete

# Local documentation
projekt.md

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Windows
Thumbs.db
Desktop.ini
